---
import { sedes, regions, hasPin, isApprox, fotos, directionsUrl, peruGeometry } from '../lib/sedes';

const cards = await Promise.all(sedes.map(async sede => ({ sede, cover: (await fotos(sede.slug))[0] })));
const count = (region: string) => sedes.filter(sede => sede.region === region).length;
---
<section id="sedes" class="locations surface-light" aria-labelledby="locations-title">

  <div class="finder" data-finder hidden>
    <div class="finder-search">
      <label for="location-search">¿En qué ciudad o pueblo buscas una iglesia?</label>
      <p id="location-search-hint" class="finder-hint">Por ejemplo: Chiclayo, Motupe, Cutervo o Pucallpa. No te preocupes por las tildes.</p>
      <div class="finder-input">
        <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2" /><path d="m15.5 15.5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
        <input id="location-search" type="search" enterkeyhint="search" autocomplete="off" aria-describedby="location-search-hint" aria-controls="locations-directory" placeholder="Escribe aquí" />
        <button type="button" class="finder-clear" data-clear-search hidden>Borrar</button>
      </div>
    </div>
    <div class="finder-near">
      <p>¿Prefieres no escribir?</p>
      <button type="button" class="button button-gold" data-near>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" /></svg>
        Mostrar las iglesias más cercanas a mí
      </button>
      <p class="finder-hint">Tu equipo te preguntará si deseas compartir tu ubicación. Solo la usamos para ordenar la lista.</p>
    </div>
    <fieldset class="finder-regions">
      <legend>También puedes elegir una región</legend>
      <div>
        <button type="button" aria-pressed="true" data-region="">Todas <span>{sedes.length}</span></button>
        {regions.map(region => <button type="button" aria-pressed="false" data-region={region}>{region} <span>{count(region)}</span></button>)}
      </div>
    </fieldset>
  </div>

  <div class="locations-layout">
    <div class="locations-results">
      <div class="location-status">
        <p id="location-count" role="status" aria-live="polite">Mostrando las {sedes.length} iglesias</p>
        <button type="button" class="text-button" data-reset-order hidden>Volver al orden normal</button>
      </div>
      <ol id="locations-directory" class="locations-directory" aria-label="Iglesias encontradas">
        {cards.map(({ sede, cover }) => (
          <li class="location-entry" data-number={sede.id} data-slug={sede.slug} data-region={sede.region} data-lat={hasPin(sede) ? sede.lat!.toFixed(6) : undefined} data-lng={hasPin(sede) ? sede.lng!.toFixed(6) : undefined} data-approx={isApprox(sede) ? '' : undefined} data-search={[sede.name, sede.city, sede.department, sede.address, sede.region, ...sede.encargados.map(e => e.nombre)].join(' ')}>
            <a class="location-photo" href={`/sedes/${sede.slug}`} tabindex="-1" aria-hidden="true">
              {cover ? <img src={cover.thumb} alt="" loading="lazy" decoding="async" /> : <span class="location-photo-empty"><img src="/assets/logo-peregrinos.png" alt="" loading="lazy" /></span>}
            </a>
            <div class="location-body">
              <h3><a href={`/sedes/${sede.slug}`}>{sede.name}</a></h3>
              <p class="location-city">{sede.city} · Región {sede.region}</p>
              {sede.address && <address>{sede.address}</address>}
              <p class="location-distance" hidden></p>
              <div class="location-actions">
                <a class="button button-gold location-open" href={`/sedes/${sede.slug}`}>Ver esta iglesia <span class="arrow" aria-hidden="true"></span></a>
                {hasPin(sede)
                  ? <button type="button" class="location-map-button" aria-pressed="false" aria-label={`Ver ${sede.name} en el mapa`}>Ver en el mapa</button>
                  : <a class="location-map-link" href={directionsUrl(sede)} target="_blank" rel="noopener noreferrer">Buscar en Google Maps</a>}
              </div>
            </div>
          </li>
        ))}
      </ol>
      <div class="locations-empty" hidden>
        <p><strong>No encontramos ninguna iglesia con ese nombre.</strong></p>
        <p>Revisa cómo está escrito, prueba con el nombre de la provincia o mira todas las iglesias.</p>
        <button type="button" class="button button-gold" data-clear-locations>Ver todas las iglesias</button>
      </div>
      <button type="button" class="button locations-more" data-more hidden></button>
    </div>

    <figure class="locations-map">
      <div class="map-toolbar" hidden><button type="button" data-peru-view>Ver todo el Perú</button><button type="button" data-fit-locations>Acercar a los resultados</button></div>
      <div id="church-map" role="region" aria-label="Mapa de las iglesias en el Perú" aria-describedby="map-description"></div>
      <p id="map-status" role="status"></p>
      <figcaption id="map-description">Toca un número del mapa para acercarte. Los puntos con borde discontinuo marcan una ubicación aproximada. Para llegar, abre la iglesia y pulsa «Cómo llegar».</figcaption>
      <script is:inline type="application/json" id="peru-geometry" set:html={peruGeometry} />
    </figure>
  </div>
  <noscript><p>El mapa y el buscador necesitan JavaScript. Puedes ver las {sedes.length} iglesias en la lista.</p></noscript>
</section>
