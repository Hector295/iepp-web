---
const council = [
  ['Obispo', 'Rvdo. José Iván Rojas de la Cruz'],
  ['Obispo auxiliar', 'Rvdo. José Ángel Durand Aguilar'],
  ['Secretario general', 'Rvdo. Félix Honorio Cuevas'],
  ['Tesorero general', 'Ps. Carlos Héctor Campos Cruzado'],
];
const regions = [
  ['Norte', 'Rvdo. José Chumacero Córdova', 'Lambayeque, Cutervo y Piura.'],
  ['Sur', 'Rvdo. Rogelio Curinambe Goicochea', 'Trujillo, Huamachuco, Santiago de Chuco y Cajabamba.'],
  ['Nor Oriente', 'Rvdo. Daniel Gonzales Cabrera', 'Jaén, San Ignacio y Bagua.'],
  ['Oriente', 'Rvdo. Amadeo Manchay Huamán', 'San Martín.'],
  ['Nor Andina', 'Rvdo. Abel Vásquez Vásquez', 'Hualgayoc-Bambamarca, Celendín, Chota y Cajamarca.'],
  ['Ucayali', 'Ps. Jorge Marcial Sangama Guzmán', 'Pucallpa y la región Ucayali.'],
];
const internalBodies = [
  ['Unión de Pastores', 'Rvda. Hilda Tenorio Barboza, presidenta'],
  ['USJEPEP', 'David Chambergo Manayay, presidente'],
  ['USFEMIEPP', 'Ana Acosta de Lavado, directora'],
];
---
<section id="organizacion" class="structure section-shell surface-light" aria-labelledby="organization-title">
  <details class="history-document organization-details">
    <summary>Concilio y presbiterios</summary>
    <h3 class="organization-heading">Concilio</h3>
    <dl class="structure-path">
      {council.map(([role, name]) => (<div><dt>{role}</dt><dd>{name}</dd></div>))}
    </dl>
    <h3 class="organization-heading">Presbiterios</h3>
    <dl class="organization-list">
      {regions.map(([region, name, territory]) => (
        <div><dt>{region}</dt><dd>{name}</dd><dd class="region-territory">{territory}</dd></div>
      ))}
    </dl>
  </details>
  <details class="history-document organization-details">
    <summary>Órganos internos y Consejo Ministerial</summary>
    <h3>Órganos internos</h3>
    <dl class="organization-list">
      {internalBodies.map(([body, name]) => (<div><dt>{body}</dt><dd>{name}</dd></div>))}
    </dl>
    <h3>Consejo Ministerial</h3>
    <ul class="council-members">
      <li>Rvda. Justa Moreno Alfaro</li>
      <li>Rvdo. Teófilo Narváez Pérez</li>
      <li>Rvda. Lidia Elizabeth Murga Gálvez</li>
    </ul>
  </details>
  <p class="directory-note">Directorio vigente de la IEPP.</p>
</section>
