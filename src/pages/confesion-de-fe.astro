---
import BaseLayout from '../layouts/BaseLayout.astro';
import Confession from '../components/Confession.astro';
import PageHeader from '../components/PageHeader.astro';

const title = 'Confesión de fe | Iglesia Evangélica de los Peregrinos del Perú';
const description = 'Los 18 artículos de fe de la Iglesia Evangélica de los Peregrinos del Perú: nuestra confesión de herencia wesleyana sobre Dios, la salvación y la vida cristiana.';
---
<BaseLayout path="/confesion-de-fe" title={title} description={description}>
  <PageHeader>
    <h1 id="confession-title">La fe que<br /><i>compartimos.</i></h1>
    <div class="page-intro"><p>Creemos en el Padre, el Hijo y el Espíritu Santo; en la salvación por la fe en Jesucristo y en una vida transformada para amar y servir.</p><p>Nuestra confesión de fe se expresa en 18 artículos. Explora las tarjetas o elige un artículo en el índice para leer su texto completo.</p></div>
  </PageHeader>
  <Confession />
</BaseLayout>
