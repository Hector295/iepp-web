---
import BaseLayout from '../layouts/BaseLayout.astro';
import Locations from '../components/Locations.astro';

const title = 'Iglesia Evangélica de los Peregrinos del Perú | IEPP';
const description = 'Iglesia de Santidad de herencia wesleyana en el Perú. Conoce nuestra identidad y encuentra tu sede en Chiclayo, Lima y otras ciudades del Perú.';

const heroPhotos = [
  'Pastores en oración con las manos alzadas durante un culto de la Iglesia.',
  'Congregación en oración bajo una carpa, en una actividad al aire libre de la Iglesia.',
  'Pastor predicando ante la congregación durante la Asamblea General y el Congreso Nacional de Santidad.',
  'Culto dominical en un templo de la Iglesia, con la congregación reunida en dos niveles.',
  'Foto grupal de pastores y líderes en el XLIII Retiro Pastoral "Firmes en la misión por la misericordia de Dios".',
  'Miembros de la Iglesia participando de la Santa Cena.',
  'Foto grupal de líderes de la Iglesia junto al mar, sobre un acantilado rocoso.',
  'Foto grupal de miembros de la Iglesia en una visita comunitaria.',
  'Foto grupal de la comunidad en una plaza pública, con la sierra al fondo.',
  'Pastor predicando al aire libre ante la comunidad, con un teclado y equipo de sonido.',
  'Pastores orando junto a un púlpito durante una reunión de la Iglesia.',
  'Congregación en oración durante un culto, con cámaras registrando el momento.',
];
---
<BaseLayout path="/" title={title} description={description} includeMap>
  <section id="inicio" class="hero" aria-labelledby="hero-title">
    <div class="hero-image hero-carousel" data-hero-carousel role="group" aria-roledescription="carrusel" aria-label="Fotos de la comunidad">
      <ul class="hero-carousel-track">
        {heroPhotos.map((alt, index) => (
          <li class={`hero-slide${index === 0 ? ' is-active' : ''}`}>
            <img src={`/assets/comunidad/${index + 1}.jpg`} alt={alt} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />
          </li>
        ))}
      </ul>
      <div class="hero-carousel-controls">
        <button type="button" class="hero-carousel-arrow" data-hero-prev aria-label="Foto anterior">‹</button>
        <div class="hero-carousel-dots" role="tablist" aria-label="Elegir foto">
          {heroPhotos.map((_, index) => (
            <button type="button" class={`hero-dot${index === 0 ? ' is-active' : ''}`} role="tab" aria-selected={index === 0} aria-label={`Foto ${index + 1} de ${heroPhotos.length}`} data-hero-dot={index}><span class="hero-dot-fill"></span></button>
          ))}
        </div>
        <span class="hero-carousel-count" data-hero-count aria-hidden="true">01 / {String(heroPhotos.length).padStart(2, '0')}</span>
        <button type="button" class="hero-carousel-arrow" data-hero-next aria-label="Foto siguiente">›</button>
      </div>
    </div>
    <div class="hero-shade"></div>
    <div class="hero-content">
      <h1 id="hero-title">Caminamos por fe.<i>Vivimos en Él.</i></h1>
      <p>Bienvenido a la Iglesia Evangélica de los Peregrinos del Perú. Somos una Iglesia de Santidad de herencia wesleyana.</p>
      <div class="hero-actions">
        <a class="button button-gold" href="#sedes">Encuentra tu iglesia <span class="arrow" aria-hidden="true"></span></a>
        <a class="text-link" href="#identidad">Conócenos</a>
      </div>
    </div>
  </section>

  <section class="welcome" aria-labelledby="welcome-title">
    <div><h2 id="welcome-title">Qué alegría encontrarnos.</h2><p>Si es tu primera visita o ya eres parte de la Iglesia, este es un lugar para conocernos y seguir caminando juntos.</p></div>
    <div class="welcome-visit"><h3>¿Quieres visitarnos?</h3><p>Encuentra una sede y comunícate con nosotros para consultar los horarios de culto.</p><a class="text-link text-link-dark" href="#contacto">Hablemos de tu visita <span class="arrow" aria-hidden="true"></span></a></div>
  </section>

  <section id="identidad" class="identity section-shell">
    <figure class="community-photo">
      <img src="/assets/comunidad-peregrinos.jpg" alt="Representación de una comunidad reunida en oración" width="1122" height="1402" loading="lazy" />
      <figcaption>Imagen ilustrativa de la vida en comunidad.</figcaption>
    </figure>
    <div class="identity-intro">
      <h2>La fe se vive<br /><i>en comunidad.</i></h2>
      <p>Desde 1904, nuestra historia en el Perú reúne fe, educación y servicio.</p>
      <div class="principles" aria-label="Visión y misión">
        <article><h3>Visión</h3><p>Una iglesia unida en la santidad wesleyana, que crece al evangelizar, educar, servir y compartir la vida, haciendo visible el Reino de Dios.</p></article>
        <article><h3>Misión</h3><p>Vivir la Gran Comisión: invitar a la conversión, formar discípulos y nuevas iglesias, y contribuir a transformar el mundo mediante la predicación, la educación y el servicio social.</p></article>
      </div>
      <a class="text-link text-link-dark" href="/confesion-de-fe">Conoce nuestra confesión de fe</a>
      <a class="text-link text-link-dark" href="/historia">Nuestra historia desde 1904</a>
    </div>
  </section>

  <Locations />
</BaseLayout>
