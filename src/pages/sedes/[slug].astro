---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sedes, fotos, hasPin, precisionNote, directionsUrl, project, peruPath, PERU_WIDTH, PERU_HEIGHT, type Sede } from '../../lib/sedes';

export function getStaticPaths() {
  return sedes.map(sede => ({ params: { slug: sede.slug }, props: { sede } }));
}

const { sede } = Astro.props as { sede: Sede };
const photos = await fotos(sede.slug);
const path = `/sedes/${sede.slug}`;
const place = [sede.city, sede.department].filter(Boolean).join(', ');
const title = `Iglesia de los Peregrinos en ${sede.name} | IEPP`;
const resumen = sede.resumen || `Somos una congregación de la Iglesia Evangélica de los Peregrinos del Perú en ${place}. Te esperamos para adorar a Dios, escuchar su Palabra y compartir en comunidad.`;
const description = `${sede.name}, ${place}: dirección, cómo llegar${sede.encargados.length ? ', encargados' : ''}${photos.length ? ' y fotos' : ''} de la Iglesia Evangélica de los Peregrinos del Perú.`;
const note = precisionNote(sede);
const dot = hasPin(sede) ? project(sede.lat!, sede.lng!) : null;
const nearby = sedes.filter(other => other.region === sede.region && other.slug !== sede.slug)
  .map(other => ({ other, d: hasPin(sede) && hasPin(other) ? (other.lat! - sede.lat!) ** 2 + (other.lng! - sede.lng!) ** 2 : Infinity }))
  .sort((a, b) => a.d - b.d).slice(0, 4).map(({ other }) => other);
const phone = sede.telefono.replace(/[^\d+]/g, '');
const canonical = new URL(path, Astro.site).href;
const schema = [{
  '@type': 'Church',
  '@id': `${canonical}#iglesia`,
  name: `Iglesia Evangélica de los Peregrinos del Perú – ${sede.name}`,
  url: canonical,
  parentOrganization: { '@id': new URL('/#iglesia', Astro.site).href },
  address: { '@type': 'PostalAddress', ...(sede.address && { streetAddress: sede.address }), addressLocality: sede.city, addressRegion: sede.department, addressCountry: 'PE' },
  ...(hasPin(sede) && { geo: { '@type': 'GeoCoordinates', latitude: sede.lat, longitude: sede.lng } }),
  ...(photos.length && { image: photos.map(photo => new URL(photo.full, Astro.site).href) }),
  ...(sede.facebook && { sameAs: [sede.facebook] }),
}];
---
<BaseLayout path={path} title={title} description={description} schema={schema} scripts={photos.length ? ['/sede.js?v=1'] : []}
  {...(photos[0] && { image: photos[0].full, imageAlt: `Foto de la iglesia ${sede.name}`, imageWidth: String(photos[0].width), imageHeight: String(photos[0].height) })}>
  <div class="subpage-back"><a class="text-link" href="/sedes">← Volver a todas las iglesias</a></div>

  <article class="sede" aria-labelledby="sede-title">
    <header class="sede-header">
      <p class="sede-kicker">Región {sede.region} · {place}</p>
      <h1 id="sede-title">{sede.name}</h1>
      <p class="sede-summary">{resumen}</p>
      <div class="sede-actions">
        <a class="button button-gold" href={directionsUrl(sede)} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" /></svg>
          Cómo llegar
        </a>
        {phone && <a class="button button-outline-light" href={`tel:${phone}`}>Llamar: {sede.telefono}</a>}
        {sede.facebook && <a class="button button-outline-light" href={sede.facebook} target="_blank" rel="noopener noreferrer">Ver su Facebook</a>}
      </div>
    </header>

    <section class="sede-gallery" aria-labelledby="gallery-title">
      <h2 id="gallery-title" class="sr-only">Fotos de la iglesia</h2>
      {photos.length ? (
        <ul class={`sede-photos sede-photos-${Math.min(photos.length, 5)}`} data-gallery>
          {photos.map((photo, index) => (
            <li>
              <a href={photo.full} data-full={photo.full} data-width={photo.width} data-height={photo.height}>
                <img src={photo.thumb} alt={`Foto ${index + 1} de ${photos.length} de la iglesia ${sede.name}`} loading={index < 3 ? 'eager' : 'lazy'} decoding="async" />
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="sede-photos-empty">
          <img src="/assets/logo-peregrinos.png" alt="" width="160" />
          <p>Pronto compartiremos fotos de esta iglesia.</p>
        </div>
      )}
      {photos.length > 1 && <p class="sede-gallery-hint">Toca una foto para verla en grande. Hay {photos.length} fotos.</p>}
    </section>

    <div class="sede-details">
      <section aria-labelledby="where-title">
        <h2 id="where-title">Dónde estamos</h2>
        <dl class="sede-facts">
          {sede.address && <div><dt>Dirección</dt><dd>{sede.address}</dd></div>}
          <div><dt>Localidad</dt><dd>{place}</dd></div>
          <div><dt>Región de la Iglesia</dt><dd>{sede.region}</dd></div>
        </dl>
        {note && <p class="sede-note">{note}</p>}
        <a class="button button-gold" href={directionsUrl(sede)} target="_blank" rel="noopener noreferrer">Abrir en Google Maps</a>
      </section>

      <figure class="sede-locator">
        <svg viewBox={`-6 -6 ${PERU_WIDTH + 12} ${PERU_HEIGHT + 12}`} role="img" aria-label={dot ? `Mapa del Perú con la ubicación de ${sede.name}` : 'Mapa del Perú'}>
          <path d={peruPath} />
          {dot && <circle class="sede-locator-halo" cx={dot[0]} cy={dot[1]} r="11" />}
          {dot && <circle class="sede-locator-dot" cx={dot[0]} cy={dot[1]} r="5" />}
        </svg>
        <figcaption>{dot ? `${sede.name} en el mapa del Perú.` : 'Ubicación en el mapa pendiente.'}</figcaption>
      </figure>

      <section aria-labelledby="people-title">
        <h2 id="people-title">Quiénes nos guían</h2>
        {sede.encargados.length ? (
          <ul class="sede-people">
            {sede.encargados.map(person => <li><strong>{person.nombre}</strong><span>{person.cargo}</span></li>)}
          </ul>
        ) : <p>Para conocer a los encargados de esta iglesia, comunícate con la sede nacional.</p>}
      </section>

      <section aria-labelledby="visit-title">
        <h2 id="visit-title">Horarios y visitas</h2>
        {sede.horarios.length
          ? <ul class="sede-schedule">{sede.horarios.map(item => <li>{item}</li>)}</ul>
          : <p>Para confirmar los días y horas de culto, llama a la sede nacional al <a href="tel:+5174226067">(074) 226067</a>{phone && <> o a esta iglesia al <a href={`tel:${phone}`}>{sede.telefono}</a></>}.</p>}
      </section>
    </div>

    {nearby.length > 0 && (
      <nav class="sede-nearby" aria-labelledby="nearby-title">
        <h2 id="nearby-title">Otras iglesias de la Región {sede.region}</h2>
        <ul>
          {nearby.map(other => <li><a href={`/sedes/${other.slug}`}><strong>{other.name}</strong><span>{other.city}</span></a></li>)}
        </ul>
        <a class="text-link" href="/sedes">Ver todas las iglesias</a>
      </nav>
    )}
  </article>

  {photos.length > 0 && (
    <dialog class="lightbox" data-lightbox aria-label={`Fotos de la iglesia ${sede.name}`}>
      <div class="lightbox-bar">
        <p data-lightbox-count aria-live="polite"></p>
        <button type="button" data-lightbox-close>Cerrar ✕</button>
      </div>
      <figure><img data-lightbox-image alt="" /></figure>
      <div class="lightbox-nav">
        <button type="button" data-lightbox-prev>‹ Anterior</button>
        <button type="button" data-lightbox-next>Siguiente ›</button>
      </div>
    </dialog>
  )}
</BaseLayout>
